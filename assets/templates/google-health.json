    {
      "name": "google_health_list_data_points",
      "slug": "google_health_list_data_points",
      "description": "Read one page of Google Health data. Follow nextPageToken explicitly. No data is unknown, never zero.",
      "endpoint_url": "https://health.googleapis.com/v4/users/me/dataTypes/{{data_type}}/dataPoints",
      "http_method": "GET",
      "tool_type": "http",
      "handler": "",
      "input_schema": {
        "type": "object",
        "properties": {
          "data_type": {
            "type": "string",
            "description": "Curated data type. Consult the inventory for supported operations.",
            "enum": [
              "steps",
              "distance",
              "total-calories",
              "active-zone-minutes",
              "heart-rate",
              "daily-resting-heart-rate",
              "daily-heart-rate-variability",
              "weight",
              "body-fat",
              "sleep",
              "nutrition-log",
              "hydration-log",
              "food",
              "food-measurement-unit"
            ]
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum points per page. Sleep is capped at 25."
          },
          "page_token": {
            "type": "string",
            "description": "Opaque nextPageToken from the previous response; keep all other inputs identical.",
            "maxLength": 2048
          },
          "filter": {
            "type": "string",
            "description": "Google AIP-160 filter. Sleep uses sleep.interval.civil_end_time; daily metrics use their snake_case date field.",
            "maxLength": 2048
          },
          "data_source_family": {
            "type": "string",
            "description": "Optional source family.",
            "enum": [
